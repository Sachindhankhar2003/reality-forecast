datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  role          UserRole    @default(USER)
  status        String      @default("ACTIVE") // ACTIVE, DISABLED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?
  profile       Profile?
  forecasts     Forecast[]
  memories      Memory[]
  interviews    Interview[]
  conversations Conversation[]
  feedbacks     UserFeedback[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

enum UserRole {
  USER
  ADMIN
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                  String?
  location             String?
  timezone             String?
  skills               String?  // Stored as JSON or comma-separated
  jobPreferences       String?
  transportPreferences String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Memory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  key         String
  value       String
  source      String   @default("user_stated")
  enabled     Boolean  @default(true)
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Forecast {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  originalInput String
  domain        String
  status        String           @default("READY")
  eventAt       DateTime?
  location      String?
  summary       String
  overallScore  Float
  confidence    Float
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  completedAt   DateTime?
  contexts      ForecastContext[]
  sources       DataSource[]
  factors       ForecastFactor[]
  scenarios     Scenario[]
  risks         Risk[]
  recommendations Recommendation[]
  whatIfRuns    WhatIfRun[]
  outcome       Outcome?
  evaluations   ForecastEvaluation[]
  personalization ForecastPersonalization?

  @@index([userId])
  @@index([status])
  @@index([domain])
  @@index([eventAt])
  @@index([createdAt])
}

model ForecastPersonalization {
  id                          String   @id @default(uuid())
  forecastId                  String   @unique
  forecast                    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  baselineScore               Float
  personalAdjustment          Float
  finalScore                  Float
  personalFactorsJson         String?
  personalConfidence          Float
  baselineModelVersion        String   @default("baseline-v1")
  personalizationModelVersion String   @default("personalized-v1")
  createdAt                   DateTime @default(now())
}

model ForecastContext {
  id                String   @id @default(uuid())
  forecastId        String
  forecast          Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  key               String
  value             String
  source            String   @default("user_input")
  confidence        Float    @default(1.0)
  createdAt         DateTime @default(now())
}

model DataSource {
  id          String   @id @default(uuid())
  forecastId  String
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  provider    String
  dataType    String
  sourceUrl   String?
  retrievedAt DateTime @default(now())
  expiresAt   DateTime?
  confidence  Float    @default(1.0)
  dataJson    String?  // JSON string

  @@index([forecastId])
  @@index([provider])
}

model ForecastFactor {
  id              String   @id @default(uuid())
  forecastId      String
  forecast        Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  name            String
  category        String
  value           String
  normalizedValue Float
  weight          Float    @default(1.0)
  impact          String   @default("POSITIVE")
  evidence        String
  createdAt       DateTime @default(now())
}

model Scenario {
  id              String   @id @default(uuid())
  forecastId      String
  forecast        Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  type            String   // BEST_CASE, MOST_LIKELY, NEGATIVE, UNEXPECTED
  title           String
  description     String
  probability     Float?
  confidence      Float    @default(0.85)
  impactScore     Float    @default(0.5)
  controllability Float    @default(0.5)
  evidence        String
  actionsJson     String?  // Recommended actions list as JSON string

  @@index([forecastId])
}

model Risk {
  id              String   @id @default(uuid())
  forecastId      String
  forecast        Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String
  likelihood      Float
  impact          Float
  controllability Float
  timeSensitivity Float    @default(0.5)
  severity        String   @default("MEDIUM")
  compositeScore  Float
  mitigation      String
  createdAt       DateTime @default(now())
}

model Recommendation {
  id              String    @id @default(uuid())
  forecastId      String
  forecast        Forecast  @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  title           String
  description     String
  expectedBenefit Float
  effort          String    @default("MODERATE")
  urgency         String    @default("MEDIUM")
  controllability Float     @default(0.8)
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model WhatIfRun {
  id              String   @id @default(uuid())
  forecastId      String
  forecast        Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  userId          String
  userInput       String
  summary         String
  deltaScore      Float
  modifiedFactors String?  // JSON string
  scenariosJson   String?  // JSON string
  createdAt       DateTime @default(now())
}

model Outcome {
  id                String              @id @default(uuid())
  forecastId        String              @unique
  forecast          Forecast            @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  userId            String
  result            String              // SUCCESS, PARTIAL, FAILED, DELAYED, CANCELLED, UNEXPECTED, CUSTOM
  customResult      String?
  notes             String?
  recordedAt        DateTime            @default(now())
  evaluation        ForecastEvaluation?

  @@index([forecastId])
}

model ForecastEvaluation {
  id                String   @id @default(uuid())
  forecastId        String
  forecast          Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  outcomeId         String   @unique
  outcome           Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  matchedScenarioId String?
  accuracyScore     Float?
  calibrationScore  Float?
  brierScore        Float?
  lessons           String?
  createdAt         DateTime @default(now())
}

model Interview {
  id                      String              @id @default(uuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  forecastId              String?
  companyName             String
  roleTitle               String
  jobDescription          String?
  resumeReference         String?
  technicalReadiness      Float               @default(0.75)
  communicationReadiness Float               @default(0.80)
  behavioralReadiness     Float               @default(0.70)
  roleMatchScore          Float               @default(0.80)
  status                  String              @default("READY")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  questions               InterviewQuestion[]

  @@index([userId])
}

model InterviewQuestion {
  id            String           @id @default(uuid())
  interviewId   String
  interview     Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionText  String
  category      String
  difficulty    String           @default("MEDIUM")
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())
  answer        InterviewAnswer?
}

model InterviewAnswer {
  id                  String            @id @default(uuid())
  questionId          String            @unique
  question            InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText          String
  score               Float             @default(0.75)
  feedback            String?
  strengthsJson       String?
  improvementsJson    String?
  followUpQuestion    String?
  answeredAt          DateTime          @default(now())
}

model APIUsage {
  id            String   @id @default(uuid())
  userId        String?
  provider      String
  endpoint      String
  requestCount  Int      @default(1)
  latencyMs     Int
  success       Boolean  @default(true)
  estimatedCost Float?   @default(0.0)
  createdAt     DateTime @default(now())

  @@index([provider])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // FORECAST_CREATED, OUTCOME_RECORDED, MEMORY_CREATED, PROFILE_UPDATED
  entityType  String
  entityId    String?
  details     String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Conversation {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String                @default("New Intelligence Conversation")
  summary       String?
  domain        String?               @default("general")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lastMessageAt DateTime              @default(now())
  messages      ConversationMessage[]

  @@index([userId])
}

model ConversationMessage {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String       // USER, ASSISTANT, SYSTEM
  content          String
  sanitizedContent String?
  contextUsed      String?      // Plain text context summary
  contextUsedJson  String?      // JSON string of structured context used
  toolCallsJson    String?      // JSON array string of tool names invoked
  timestamp        DateTime     @default(now())

  @@index([conversationId])
}

model UserFeedback {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String    // BUG, FEATURE_REQUEST, INCORRECT_FORECAST, WRONG_INFO, OTHER
  message       String
  forecastId    String?
  status        String    @default("OPEN") // OPEN, IN_REVIEW, PLANNED, RESOLVED, REJECTED
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  adminResponse String?
  adminNote     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL") // FORECAST_UPDATE, RISK_ALERT, ADMIN_REPLY, REMINDER
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}


