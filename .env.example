# Database Connection (SQLite local / PostgreSQL production)
DATABASE_URL="postgresql://user:password@hostname.render.com:5432/dbname"

# Auth.js v5 Authentication Secret & Public Application URL
AUTH_SECRET="your-production-auth-secret-here-at-least-32-chars"
NEXTAUTH_URL="https://reality-forecast.onrender.com"
NEXT_PUBLIC_APP_URL="https://reality-forecast.onrender.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Provider Integrations & Telemetry
OPEN_METEO_BASE_URL="https://api.open-meteo.com"
GEMINI_API_KEY="your-gemini-api-key-optional"
TOMTOM_API_KEY="your-tomtom-traffic-api-key-optional"
MAPBOX_ACCESS_TOKEN="your-mapbox-token-optional"

# System Execution Environment
NODE_ENV="production"
